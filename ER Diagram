##Mermaid chart for ER diagram
---
config:
  theme: neo
  layout: auto
---
erDiagram
	direction TB
	Departments {
		Int Department_id  ""  
		String Department_name  ""  
	}

	Employees {
		int BRANCHid  ""  
		int EmployeeID  ""  
		String First_name  ""  
		date Hire_date  ""  
		string Last_name  ""  
		int Manager_id  ""  
		int department_id  ""  
		int Promotion_id  ""  
		int Project_id  ""  
	}

	Projects {
		int Project_id  ""  
		string Project_name  ""  
	}

	Manager {
		Int Manager_id  ""  
		String Manager_name  ""  
	}

	Promotions {
		Int Promotion_id  ""  
		String Current_role  ""  
		String promoted_to  ""  
	}

	Employees||--||Departments:"belongs to"
	Employees||--|{Promotions:"Zero or more promotions"
	Employees||--|{Manager:"have 0 or more manager"
	Departments||--|{Employees:"has multiple employees"
	Employees||--|{Projects:"Works on multiple projects"
	Projects||--|{Employees:"Projects can have multiple emp"

	style Departments fill:transparent,stroke:#FF6D00

	Departments:::Ash
	Projects:::Sky
	Manager:::Peach
	Promotions:::Aqua

	classDef Aqua :,stroke-width:1px, stroke-dasharray:none, stroke:#46EDC8, fill:#DEFFF8, color:#378E7A
	classDef Peach :,stroke-width:1px, stroke-dasharray:none, stroke:#FBB35A, fill:#FFEFDB, color:#8F632D
	classDef Sky :,stroke-width:1px, stroke-dasharray:none, stroke:#374D7C, fill:#E2EBFF, color:#374D7C
	classDef Ash :,stroke-width:1px, stroke-dasharray:none, stroke:#999999, fill:#EEEEEE, color:#000000
